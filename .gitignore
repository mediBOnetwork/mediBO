#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.env
scripts/*.json

# Downloadable Android APK — 85MB binary, uploaded to Cloudflare by deploy.sh
# but never committed to git. Rebuilt by the android-build lane.
/app.apk
build/web/app.apk
android/key.properties
medibo-release.jks

# Claude Code worktrees (per-change isolated checkouts) — never track these
.claude/worktrees/
build/native_assets/
build/test_cache/
build/unit_test_assets/
