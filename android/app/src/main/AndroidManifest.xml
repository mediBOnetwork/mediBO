<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access for all Supabase / storefront traffic. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voice-count / voice-receive recording (requested at point of use). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Barcode scanning + photo capture (requested at point of use). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Android 13+ push/local notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- CHANGE #985 — the rider's position while the run screen is open
         (in-app polling). The CHANGE #700 foreground location service and its
         FOREGROUND_SERVICE / FOREGROUND_SERVICE_LOCATION permissions were
         removed for the 1.3.21 (35) Play release: Play gates them behind a
         Console-only declaration form. ACCESS_BACKGROUND_LOCATION is still
         deliberately NOT requested. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- CMD #2015 — the order alert is an ordinary notification again.
         The full-screen-intent permission is GONE: a lock-screen takeover is the
         alarm/calling treatment that let the old alert bypass silent mode,
         Do Not Disturb and the volume keys. The alert is now a heads-up
         notification on a normal channel that honours the ringer, with a
         Stop action on it. VIBRATE stays for the system's own use; WAKE_LOCK
         is what lets the tray update while the screen is off. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- CHANGE #306 — data-only order alerts land here even when the app
             is backgrounded or dead, which is the only way a full-screen
             intent can be raised. The firebase_messaging plugin drives Dart
             from its OWN broadcast receiver, so this service never takes the
             Flutter path away from it. -->
        <service
            android:name=".MediboMessagingService"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <!-- CMD #1931 — the payment notification listener. Android binds it
             itself once the user grants notification access in Settings; it is
             never started by the app. It reads ONLY the packages the backend
             listed (payment_listener_boot) and drops everything else on the
             phone. Play treats this as a sensitive permission: the
             notification-listener declaration is filed against every release. -->
        <service
            android:name=".PaymentNotificationListenerService"
            android:exported="true"
            android:label="@string/pay_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- CMD #2015 — Stop. The one button on the notification that kills
             the sound and the alert on the spot. Accept / Reject left this
             surface in CMD #1988: a decision is taken on the order screen. -->
        <receiver
            android:name=".OrderAlertActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="in.medibo.app.ORDER_ALERT_STOP"/>
            </intent-filter>
        </receiver>

        <!-- CMD #2185 — the Google Maps Android SDK key. google_maps_flutter
             reads it from HERE and nowhere else: without it every native map
             threw "API key not found" and the Location step printed the
             backend's "The map cannot open on this device" instead of tiles.
             The same key lives in map_config.native_key_android, which is what
             decides (per platform) whether a map is drawn by Google at all —
             this entry only lets the SDK start. It is restricted to
             in.medibo.app with the Play app-signing and upload SHA-1s. No
             other key belongs in this repo. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBHQ8p5PnMb4_PjWPVsIsb7_nI8A3LrHn8"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
