[Unit]
Description=mediBO nightly safety net — auth matrix, property fuzzing, invariant oracles (CHANGE #636)
Documentation=CHANGE #636. The cron task c636_safety_net_nightly only ENQUEUES; this unit drains it. Never move autotest_safety_net_run() back onto cron_dispatch(): it is minutes of work inside a 15 s dblink budget and it takes the whole tick with it (#1808).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/mediBO
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/mediBO-runner:/home/ubuntu/flutter/bin:/home/ubuntu/.npm-global/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/ubuntu/mediBO-runner/runner.env
ExecStart=/bin/bash /home/ubuntu/mediBO/scripts/safety_net_lane.sh
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
