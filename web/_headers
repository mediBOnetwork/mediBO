# ── Entry points — always fresh ────────────────────────────────────────────
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# ── Flutter engine — long-lived (flutter.js changes only on Flutter upgrades) ─
/flutter.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Static info pages — never cache so CF/browsers always fetch fresh ──────
/about
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/about.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── App bundle — no cache (Cloudflare overrides revalidate-only for .js) ────
/main.dart.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Hashed static assets — fully immutable ─────────────────────────────────
/assets/**
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/**
  Cache-Control: public, max-age=31536000, immutable

/icons/**
  Cache-Control: public, max-age=31536000, immutable

# ── Everything else — short cache ──────────────────────────────────────────
/*
  Cache-Control: public, max-age=3600
