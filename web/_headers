# CHANGE #237: removed Cache-Control from /* wildcard — Cloudflare Pages MERGES
# headers from all matching rules, so the old "public, max-age=3600" wildcard was
# being appended to specific no-cache rules, causing CDN to cache the SW + index.html.

# ── Entry points + namers — always fresh ────────────────────────────────────
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/main.dart.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/about
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/about.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Hashed bundle — long-lived but NOT immutable (2026-07-13 outage) ────────
# `immutable, max-age=31536000` meant a single wrong response (SPA-shell HTML,
# served by some edge node during a deploy's propagation-race window) would be
# stuck at that edge for a full year with no way to clear it except a manual
# purge. The URL is still unique per deploy (fingerprinted), so this loses
# almost nothing in practice — the file is never re-requested by the same
# client after a new deploy changes the filename — but a bad response now
# self-heals within a day instead of surviving a year.
/main.*.dart.js
  Cache-Control: public, max-age=86400, must-revalidate

# ── Static assets — fully immutable ─────────────────────────────────────────
/assets/**
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/**
  Cache-Control: public, max-age=31536000, immutable

/icons/**
  Cache-Control: public, max-age=31536000, immutable

# ── Demo files — forced instant download ─────────────────────────────────────
/demo/*
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600

# ── Everything else — security header only; NO Cache-Control (would merge/corrupt above) ──
/*
  X-Content-Type-Options: nosniff
