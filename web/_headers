# CHANGE #237: removed Cache-Control from /* wildcard — Cloudflare Pages MERGES
# headers from all matching rules, so the old "public, max-age=3600" wildcard was
# being appended to specific no-cache rules, causing CDN to cache the SW + index.html.

# ── Entry points + namers — always fresh ────────────────────────────────────
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter_bootstrap.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/firebase-messaging-sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/about
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/about.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Hashed bundle — immutable (URL is unique per deploy) ────────────────────
/main.*.dart.js
  Cache-Control: public, max-age=31536000, immutable

# ── Static assets — fully immutable ─────────────────────────────────────────
/assets/**
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/**
  Cache-Control: public, max-age=31536000, immutable

/icons/**
  Cache-Control: public, max-age=31536000, immutable

# ── Everything else — security header only; NO Cache-Control (would merge/corrupt above) ──
/*
  X-Content-Type-Options: nosniff
